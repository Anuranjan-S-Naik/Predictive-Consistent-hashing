{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "title": "Request Rate by Class",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        { "expr": "rate(paf_requests_classified_total{class=\"Light\"}[30s])", "legendFormat": "Light", "refId": "A" },
        { "expr": "rate(paf_requests_classified_total{class=\"Medium\"}[30s])", "legendFormat": "Medium", "refId": "B" },
        { "expr": "rate(paf_requests_classified_total{class=\"Heavy\"}[30s])", "legendFormat": "Heavy", "refId": "C" }
      ]
    },
    {
      "title": "Class Distribution (Pie)",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(paf_requests_classified_total) by (class)", "legendFormat": "{{class}}", "refId": "A" }
      ]
    },
    {
      "title": "Routing Hops Distribution",
      "type": "histogram",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "paf_routing_hops_bucket", "legendFormat": "{{le}}", "refId": "A" }
      ]
    },
    {
      "title": "Requests per Node (by Class)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(paf_node_requests_by_class_total[30s])", "legendFormat": "{{node}} — {{class}}", "refId": "A" }
      ]
    },
    {
      "title": "Allocation Score Trend",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "paf_allocation_score", "legendFormat": "{{node}}", "refId": "A" }
      ]
    },
    {
      "title": "Chord Overflow Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [
        { "expr": "rate(paf_chord_overflow_total[5m]) / rate(paf_requests_total[5m])", "refId": "A" }
      ]
    },
    {
      "title": "Classifier Confidence (Avg)",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "thresholds": { "steps": [
        { "color": "red", "value": null },
        { "color": "yellow", "value": 0.55 },
        { "color": "green", "value": 0.8 }
      ]}}},
      "targets": [
        { "expr": "paf_classifier_confidence_avg", "refId": "A" }
      ]
    },
    {
      "title": "Total Requests",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(paf_requests_total)", "refId": "A" }
      ]
    },
    {
      "title": "Classifier Fallback Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [
        { "expr": "rate(paf_classifier_fallback_total[5m]) / rate(paf_requests_total[5m])", "refId": "A" }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["paf", "requests", "flow"],
  "time": { "from": "now-15m", "to": "now" },
  "title": "PAF — Request Flow & Class Distribution",
  "uid": "paf-request-flow",
  "version": 1
}
