FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python deps (only what node needs)
COPY requirements.txt .
RUN pip install --no-cache-dir grpcio==1.62.0 protobuf==4.25.3 \
    prometheus-client==0.20.0 pyyaml==6.0.1 pydantic==2.6.3 \
    uvicorn[standard]==0.27.1 fastapi==0.110.0 httpx==0.27.0

# Copy application code
COPY node/ /app/node/
COPY coordinator/grpc/ /app/coordinator/grpc/
RUN touch /app/coordinator/__init__.py
COPY config.yaml /app/config.yaml

# Expose ports: gRPC (dynamic) + Prometheus metrics (9100)
EXPOSE 50051 9100

# Run node
CMD ["python", "-m", "node.main"]
