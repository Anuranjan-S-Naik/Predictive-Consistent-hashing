# ============================================================================
# Environment Variables — Predictive Adaptive Request Allocation Framework
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================================

# --- PostgreSQL ---
POSTGRES_PASSWORD=paf_secret
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- InfluxDB ---
INFLUXDB_TOKEN=paf-influx-token
INFLUXDB_PASSWORD=paf_influx_secret
INFLUXDB_PORT=8086

# --- Coordinator ---
COORDINATOR_PORT=8000
COORDINATOR_GRPC_PORT=50050

# --- Authentication ---
API_KEY=dev-api-key-change-me
ADMIN_API_KEY=dev-admin-key-change-me

# --- Monitoring ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# --- Traffic Generator ---
SCENARIO=uniform.yaml

# --- Logging ---
LOG_LEVEL=INFO
